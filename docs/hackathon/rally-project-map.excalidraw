    {
      "id": "te0178",
      "type": "text",
      "x": 40,
      "y": 520,
      "width": 740,
      "height": 400,
      "angle": 0,
      "strokeColor": "#191122",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "fr0167",
      "index": "a00178",
      "roundness": null,
      "seed": 1323836039,
      "version": 1,
      "versionNonce": 1749529852,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Say out loud if a judge pokes the demo\n\n\u2022 Testnet only. Faucet USDC. No real money.\n\u2022 Magic OTP is human-in-the-browser. Not headless.\n\u2022 Fresh email wallets have no USDC \u2014 dispenser or\n  the disclosed relayer-front path covers the demo.\n\u2022 Relayer can mis-label a CCTP mint; it cannot steal.\n\u2022 Circles you create for real are self-custodied.\n  The \u201cdemo friends\u201d toggle is us, labeled.\n\u2022 Attribution hook is the named mainnet follow-up.",
      "originalText": "Say out loud if a judge pokes the demo\n\n\u2022 Testnet only. Faucet USDC. No real money.\n\u2022 Magic OTP is human-in-the-browser. Not headless.\n\u2022 Fresh email wallets have no USDC \u2014 dispenser or\n  the disclosed relayer-front path covers the demo.\n\u2022 Relayer can mis-label a CCTP mint; it cannot steal.\n\u2022 Circles you create for real are self-custodied.\n  The \u201cdemo friends\u201d toggle is us, labeled.\n\u2022 Attribution hook is the named mainnet follow-up.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "re0177",
      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 16
    },
