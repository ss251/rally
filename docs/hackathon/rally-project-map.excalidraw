      "versionNonce": 1761246660,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The promise (say this once, then show it)\n\n\u2022 One shareable link\n\u2022 Email in \u2014 no seed, no extension, no gas\n\u2022 Chip in from whatever chain they already hold USDC on\n\u2022 A contract holds the pot\n\u2022 Hit the condition \u2192 payout. Miss it \u2192 everyone is refunded.",
      "originalText": "The promise (say this once, then show it)\n\n\u2022 One shareable link\n\u2022 Email in \u2014 no seed, no extension, no gas\n\u2022 Chip in from whatever chain they already hold USDC on\n\u2022 A contract holds the pot\n\u2022 Hit the condition \u2192 payout. Miss it \u2192 everyone is refunded.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "re0034",
      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 16
    },
