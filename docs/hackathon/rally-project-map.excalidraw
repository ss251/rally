      "versionNonce": 695619580,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Dispenser treasury\n0x4F2C\u2026F593\n\nDedicated faucet key.\nBase USDC (~17) + gas.\nGitHub-gated, 1 claim /\nwallet + GH account.\nAllowlist: ss251\n\nA bug here cannot touch\nthe relayer or vaults.\nThis is how empty email\nwallets get their first\ntestnet USDC.",
      "originalText": "Dispenser treasury\n0x4F2C\u2026F593\n\nDedicated faucet key.\nBase USDC (~17) + gas.\nGitHub-gated, 1 claim /\nwallet + GH account.\nAllowlist: ss251\n\nA bug here cannot touch\nthe relayer or vaults.\nThis is how empty email\nwallets get their first\ntestnet USDC.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "re0171",
      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 16
