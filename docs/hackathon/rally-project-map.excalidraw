    },
    {
      "id": "te0164",
      "type": "text",
      "x": 40,
      "y": 500,
      "width": 740,
      "height": 420,
      "angle": 0,
      "strokeColor": "#191122",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "fr0133",
      "index": "a00164",
      "roundness": null,
      "seed": 664456320,
      "version": 1,
      "versionNonce": 1559380451,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Safety properties (memorize)\n\n\u2022 A round pays the FULL pot or nobody. No partials.\n\u2022 refundable(m) = deposited(m) \u2212 claimedCount \u00d7 amount\n\u2022 Already-paid pots stay paid. Early winner who later\n  defaults keeps winnings minus their deposits \u2014 same\n  as a real chit fund. Contract guarantee is narrower:\n  no unpaid-for pot, every still-held deposit refunds.\n\u2022 No organizer abort after start (can\u2019t weaponize unwind).\n\u2022 Unclaimed pots on a healthy circle never expire.\n\u2022 Ownerless: there is no admin key. Period.",
      "originalText": "Safety properties (memorize)\n\n\u2022 A round pays the FULL pot or nobody. No partials.\n\u2022 refundable(m) = deposited(m) \u2212 claimedCount \u00d7 amount\n\u2022 Already-paid pots stay paid. Early winner who later\n  defaults keeps winnings minus their deposits \u2014 same\n  as a real chit fund. Contract guarantee is narrower:\n  no unpaid-for pot, every still-held deposit refunds.\n\u2022 No organizer abort after start (can\u2019t weaponize unwind).\n\u2022 Unclaimed pots on a healthy circle never expire.\n\u2022 Ownerless: there is no admin key. Period.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "re0163",
      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 15
    },
    {
      "id": "re0165",
      "type": "rectangle",
      "x": 820,
      "y": 500,
      "width": 700,
      "height": 420,
      "angle": 0,
      "strokeColor": "#191122",
