      "versionNonce": 1204044313,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Gasless key\n0xe872\u2026cE89\n\nValid key.\nZero balances today.\nSpike scripts only.\nDo not use in the pitch.",
      "originalText": "Gasless key\n0xe872\u2026cE89\n\nValid key.\nZero balances today.\nSpike scripts only.\nDo not use in the pitch.",
