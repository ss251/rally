      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The thesis\n\nCrowdfunding strangers is a graveyard.\nThe money that actually pools is money\nbetween people who know each other.\nNobody owns that primitive.",
      "originalText": "The thesis\n\nCrowdfunding strangers is a graveyard.\nThe money that actually pools is money\nbetween people who know each other.\nNobody owns that primitive.",
