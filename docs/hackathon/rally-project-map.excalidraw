      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "te0166",
      "type": "text",
      "x": 820,
      "y": 500,
      "width": 700,
      "height": 420,
      "angle": 0,
      "strokeColor": "#191122",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "fr0133",
      "index": "a00166",
      "roundness": null,
      "seed": 1755787369,
      "version": 1,
      "versionNonce": 1080444618,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Two organizer lanes (do not conflate)\n\nSELF-CUSTODY (real product)\n  createCircle from creator\u2019s 7702 wallet\n  they sign every invite in the browser\n  only they can start\n  Rally server can only submit already-signed msgs\n\nDEMO FRIENDS (toggle on /circles/new)\n  Relayer is the on-chain organizer\n  so a solo pitch can mint invites on demand\n  UI discloses this. Judges will ask. Say it first.\n\nClaims are NEVER relayed \u2014 pot pays msg.sender.\nPayee claims gaslessly from their own email wallet.",
      "originalText": "Two organizer lanes (do not conflate)\n\nSELF-CUSTODY (real product)\n  createCircle from creator\u2019s 7702 wallet\n  they sign every invite in the browser\n  only they can start\n  Rally server can only submit already-signed msgs\n\nDEMO FRIENDS (toggle on /circles/new)\n  Relayer is the on-chain organizer\n  so a solo pitch can mint invites on demand\n  UI discloses this. Judges will ask. Say it first.\n\nClaims are NEVER relayed \u2014 pot pays msg.sender.\nPayee claims gaslessly from their own email wallet.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "re0165",
      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 15
    },
