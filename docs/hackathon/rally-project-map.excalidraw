      "versionNonce": 362264198,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Celebration copy (the product\u2019s voice)\n\n\u2022 You're in \u2726\n\u2022 You got the pot \u2726\n\u2022 Money's back \u2726\n\nThe bar is the light source. Chain colors live\nin the mercury (Base blue \u00b7 Arb cyan \u00b7 OP coral).\nCanvas is warm plum, not crypto-black.",
      "originalText": "Celebration copy (the product\u2019s voice)\n\n\u2022 You're in \u2726\n\u2022 You got the pot \u2726\n\u2022 Money's back \u2726\n\nThe bar is the light source. Chain colors live\nin the mercury (Base blue \u00b7 Arb cyan \u00b7 OP coral).\nCanvas is warm plum, not crypto-black.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "re0071",
      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 16
    },
