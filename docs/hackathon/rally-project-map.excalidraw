      "versionNonce": 1736482969,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Rally is conditional group money.\nOne link lets people who already know each other move money together under a condition a contract enforces.\nIt pays out together \u2014 or it refunds everyone. Automatically. Nobody holds the pot. Including us.",
      "originalText": "Rally is conditional group money.\nOne link lets people who already know each other move money together under a condition a contract enforces.\nIt pays out together \u2014 or it refunds everyone. Automatically. Nobody holds the pot. Including us.",
