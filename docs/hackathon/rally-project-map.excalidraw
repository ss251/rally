      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "What they never see\n\n\u2022 A seed phrase or recovery kit\n\u2022 A browser extension or \u201cconnect wallet\u201d\n\u2022 A gas prompt or ETH faucet lecture\n\u2022 A network switcher\n\u2022 A bridge UI or \u201cwrapped USDC\u201d\n\u2022 The words CCTP, 7702, paymaster, relayer",
      "originalText": "What they never see\n\n\u2022 A seed phrase or recovery kit\n\u2022 A browser extension or \u201cconnect wallet\u201d\n\u2022 A gas prompt or ETH faucet lecture\n\u2022 A network switcher\n\u2022 A bridge UI or \u201cwrapped USDC\u201d\n\u2022 The words CCTP, 7702, paymaster, relayer",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "re0069",
      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 16
    },
